{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD-PDF",
  "version": "0.1.0",
  "identifier": "com.mdpdf.knowledgebase",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [{ "title": "MD-PDF — Textbook Knowledge Base", "width": 1360, "height": 860, "minWidth": 980, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:8765 data: blob:; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
